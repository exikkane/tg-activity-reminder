# Copy to .env and fill secrets. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Optional: SOCKS5/HTTP proxy only for Telegram. Keep credentials out of source control.
TELEGRAM_PROXY_URL=
YOUTRACK_BASE_URL=https://youtrack.example.com
YOUTRACK_HUB_URL=https://youtrack.example.com/hub
YOUTRACK_OAUTH_CLIENT_ID=your-oauth-client-id
YOUTRACK_OAUTH_CLIENT_SECRET=
YOUTRACK_OAUTH_SCOPE=YouTrack
OAUTH_OFFLINE=true
APP_BASE_URL=https://bot.example.com
YOUTRACK_OAUTH_REDIRECT_URI=https://bot.example.com/oauth/callback
# Generate with cryptography.fernet.Fernet.generate_key()
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:////data/bot.db
BOT_TIMEZONE=Europe/Ulyanovsk
REMINDER_TIME=20:00
REMINDER_DAYS=mon,tue,wed,thu,fri
MAX_DURATION_MINUTES=960
ALLOWED_TELEGRAM_IDS=
# Only these Telegram IDs can download all registered users' reports. Empty = disabled.
REPORT_ADMIN_TELEGRAM_IDS=
LOG_LEVEL=INFO
RUN_BOT=true
ALLOW_LOCAL_HTTP=false
BOT_HTTP_PORT=8080
